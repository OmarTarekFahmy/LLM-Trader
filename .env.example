# Copy to .env for local runs. In CI these are GitHub Actions repository secrets.

# --- LLM: OpenRouter primary, then Gemini, then Groq (each if its key is set) ---
OPENROUTER_API_KEY=
# Optional. Defaults to google/gemma-4-26b-a4b-it:free.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Fallbacks (optional). Leave set to cover OpenRouter's free-model daily cap;
# clear them to run OpenRouter-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Market data ---
# Primary is Yahoo Finance (no key needed - EGX '.CA' symbols + '^CASE30' index).
# EGXAPI is offline and Twelve Data gates EGX behind the paid Pro plan, so both
# spec-named providers are unused. Set this only if you upgrade Twelve Data to
# Pro and want it as a real fallback.
TWELVEDATA_API_KEY=

# --- Local testing switches (never set in CI) ---
# DRY_RUN=1        # run the cycle but do not write state files
# FORCE_SESSION=1  # bypass the Cairo session-hours gate
# MOCK_LLM=1       # deterministic fake LLM, no network
# MOCK_MARKET=1    # deterministic fake market data, no network
# MODE=eod         # end-of-day mark-to-market snapshot instead of a trade cycle
# STRATEGY=swing   # run only one strategy from state/strategies.json (default: all)
