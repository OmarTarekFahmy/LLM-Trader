# Copy to .env for local runs. In CI these are GitHub Actions repository secrets.

# --- LLM (MVP: Gemini only) ---
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Market data (MVP: Twelve Data only; EGXAPI stub is not wired in) ---
TWELVEDATA_API_KEY=

# --- Resilience phase (not required for MVP) ---
GROQ_API_KEY=
EGXAPI_API_KEY=

# --- Local testing switches (never set in CI) ---
# DRY_RUN=1        # run the cycle but do not write a commit marker
# FORCE_SESSION=1  # bypass the Cairo session-hours gate
# MOCK_LLM=1       # deterministic fake LLM, no network
# MOCK_MARKET=1    # deterministic fake market data, no network
# MODE=eod         # end-of-day mark-to-market snapshot instead of a trade cycle
