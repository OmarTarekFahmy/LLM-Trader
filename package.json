{
  "name": "llm-trader-bot",
  "version": "0.1.0",
  "private": true,
  "description": "EGX LLM paper trader — scheduled bot (GitHub Actions). Dashboard lives in dashboard/.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cycle": "tsx bot/index.ts",
    "cycle:dry": "cross-env DRY_RUN=1 tsx bot/index.ts",
    "cycle:mock": "cross-env DRY_RUN=1 FORCE_SESSION=1 MOCK_LLM=1 MOCK_MARKET=1 tsx bot/index.ts",
    "eod": "cross-env MODE=eod tsx bot/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"bot/**/*.test.ts\""
  },
  "dependencies": {
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.7.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
