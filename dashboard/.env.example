# Base URL for the committed state/ JSON files. In production set this in the
# Vercel project settings to your repo's raw GitHub URL, e.g.:
#   STATE_BASE_URL=https://raw.githubusercontent.com/<owner>/LLM-Trader/main/state
#
# If unset, the dashboard reads ../state from disk (works for `next dev` inside
# this repo, and for a Vercel build from the repo root where state/ is present).
STATE_BASE_URL=

# --- Optional: external-scheduler relay (app/api/trigger) ---
# GitHub Actions' own `schedule:` trigger is unreliable at short intervals (see
# README). This pair lets a free external pinger (e.g. cron-job.org) hit
# /api/trigger on a real schedule, which then calls the GitHub API to dispatch
# trade-cycle.yml. Both are server-only Vercel env vars; neither is ever sent
# to the external pinger or the browser.

# A GitHub personal access token used ONLY to call
# POST .../actions/workflows/trade-cycle.yml/dispatches. Classic PAT with the
# `public_repo` scope, or a fine-grained PAT with Actions: Read and write on
# this repo, is enough.
GH_DISPATCH_TOKEN=

# A secret you make up. The external pinger must send it back as ?secret=... or
# an `x-cron-secret` header, or /api/trigger returns 401. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
