# Base URL for the committed state/ JSON files. In production set this in the
# Vercel project settings to your repo's raw GitHub URL, e.g.:
#   STATE_BASE_URL=https://raw.githubusercontent.com/<owner>/LLM-Trader/main/state
#
# If unset, the dashboard reads ../state from disk (works for `next dev` inside
# this repo, and for a Vercel build from the repo root where state/ is present).
STATE_BASE_URL=
